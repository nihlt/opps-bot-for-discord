DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# The dev/test channel -- a local run posts here by default (see
# DISCORD_TARGET below), never to DISCORD_CHANNEL_ID unless told to.
TEST_DISCORD_CHANNEL_ID=
# "test" (default) or "prod" -- which of TEST_DISCORD_CHANNEL_ID /
# DISCORD_CHANNEL_ID a run actually posts to. Unset, or anything other
# than "prod", means test; reaching prod requires setting this
# explicitly. GitHub Actions sets DISCORD_TARGET=prod for the scheduled
# run -- that's the only place it should ever be "prod". See
# docs/discord-integration.md.
DISCORD_TARGET=
ADMIN_DISCORD_USER_IDS=
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_FEED_DATABASE_ID=
GEMINI_MODEL=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
SCRAPE_CONCURRENCY=
# Optional, ad-hoc use only -- unset for normal daily runs. See
# docs/architecture.md#which-items-actually-get-posted-digest_lookback_days
DIGEST_LOOKBACK_DAYS=
